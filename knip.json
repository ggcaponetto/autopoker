{
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/shared": {
      "project": "src/**/*.ts"
    },
    "packages/core": {
      "project": "src/**/*.ts"
    },
    "packages/llm": {
      "project": "src/**/*.ts"
    },
    "apps/server": {
      "project": "src/**/*.ts"
    },
    "apps/ui": {
      "project": "src/**/*.{ts,tsx}"
    },
    "docs": {
      "entry": [".vitepress/config.ts"],
      "project": ".vitepress/**/*.ts",
      "ignoreDependencies": ["mermaid"]
    }
  }
}
